# Copied to ~/.bellavolta-ci.env by install-mac.sh. Keep that copy private (chmod 600), never commit it.
# install-mac.sh fills the ASC_* key and NTFY_TOPIC from ~/.shovey-ci.env or ~/.bus-switch-ci.env when
# one exists, so the same App Store Connect key and phone notifications are shared across the games.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API, role: App Manager).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"

# Apple Developer team that owns the Bellavolta app record (same team as Shovey and Bus Switch).
BELLAVOLTA_TEAM_ID=4B8Z6NM2D4
# Bundle ID of the App Store Connect app record. Leave commented out to use com.fostersdigital.bellavolta.
# BELLAVOLTA_BUNDLE_ID=com.fostersdigital.bellavolta

# Written to ITSAppUsesNonExemptEncryption so builds skip the export-compliance question.
# Bellavolta makes no network calls at all, so "no". Change it if that stops being true.
BELLAVOLTA_NON_EXEMPT_ENCRYPTION=no

# Push notifications through the ntfy app (same topic as the other games is fine).
NTFY_TOPIC=

# Only change these if your setup differs.
# BELLAVOLTA_UNITY=/Applications/Unity/Hub/Editor/6000.6.3f1/Unity.app/Contents/MacOS/Unity
# BELLAVOLTA_BRANCH=TestFlight
# BELLAVOLTA_CI_ROOT="$HOME/BellavoltaCI"
# BELLAVOLTA_REPO_URL=https://github.com/Observe-1/BellavoltaAndHopward.git
# Wait while these other pipelines' build locks exist (space separated, empty to never wait):
# BELLAVOLTA_WAIT_FOR_LOCKS="$HOME/ShoveyCI/lock $HOME/BusSwitchCI/lock"
